#!/usr/bin/env python3
"""
logger_node.py — Unified data logger
Subscribes directly to MAVROS topics at native rates.
Writes timestamped run folder with all data + metadata.
"""

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy
from drone_mission_msgs.msg import PayloadAngles, MissionState, MissionEvent
from mavros_msgs.msg import State, RCOut, VfrHud, NavControllerOutput
from nav_msgs.msg import Odometry
from sensor_msgs.msg import Imu, NavSatFix, BatteryState
from geometry_msgs.msg import TwistStamped, TwistWithCovarianceStamped
from std_msgs.msg import String
import csv, os, json, shutil, math
from datetime import datetime

SENSOR_QOS = QoSProfile(
    reliability=ReliabilityPolicy.BEST_EFFORT,
    durability=DurabilityPolicy.VOLATILE,
    depth=10)

RELIABLE_QOS = QoSProfile(
    reliability=ReliabilityPolicy.RELIABLE,
    durability=DurabilityPolicy.VOLATILE,
    depth=10)

def quat_to_rpy_deg(q):
    sinr = 2.0*(q.w*q.x + q.y*q.z)
    cosr = 1.0 - 2.0*(q.x*q.x + q.y*q.y)
    roll = math.degrees(math.atan2(sinr, cosr))
    sinp = 2.0*(q.w*q.y - q.z*q.x)
    sinp = max(-1.0, min(1.0, sinp))
    pitch = math.degrees(math.asin(sinp))
    siny = 2.0*(q.w*q.z + q.x*q.y)
    cosy = 1.0 - 2.0*(q.y*q.y + q.z*q.z)
    yaw = math.degrees(math.atan2(siny, cosy))
    return round(roll,4), round(pitch,4), round(yaw,4)


class LoggerNode(Node):
    def __init__(self):
        super().__init__('logger_node')

        # ── Parameters ────────────────────────────────
        self.declare_parameter('log_base_dir',  '/home/pi/logs')
        self.declare_parameter('run_label',     'unlabeled')
        self.declare_parameter('mission_file',  '')
        self.declare_parameter('config_file',   '')
        self.declare_parameter('operator',      'unknown')
        self.declare_parameter('shaper_type',   'none')
        self.declare_parameter('rope_length',   0.0)
        self.declare_parameter('notes',         '')
        self.declare_parameter('log_flight',    True)
        self.declare_parameter('log_angles',    True)
        self.declare_parameter('log_events',    True)
        self.declare_parameter('autostart',     True)

        base_dir     = self.get_parameter('log_base_dir').value
        self.label   = self.get_parameter('run_label').value
        self.mission = self.get_parameter('mission_file').value
        self.config  = self.get_parameter('config_file').value
        self.operator= self.get_parameter('operator').value
        self.shaper  = self.get_parameter('shaper_type').value
        self.rope    = self.get_parameter('rope_length').value
        self.notes   = self.get_parameter('notes').value
        log_flight   = self.get_parameter('log_flight').value
        log_angles   = self.get_parameter('log_angles').value
        log_events   = self.get_parameter('log_events').value
        autostart    = self.get_parameter('autostart').value

        # ── Run folder ────────────────────────────────
        self.timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        self.run_dir   = os.path.join(base_dir,
                         f'{self.timestamp}_{self.label}')
        os.makedirs(self.run_dir, exist_ok=True)

        # ── State ─────────────────────────────────────
        self.logging_active  = False
        self.mission_active  = False
        self.mission_start_t = None
        self.flight_rows     = 0
        self.angle_rows      = 0
        self.event_rows      = 0
        self._last_mission_state = None

        # MAVROS data buckets
        self._odom      = None
        self._vel_body  = None
        self._imu       = None
        self._gps       = None
        self._battery   = None
        self._rc_out    = None
        self._mav_state = None
        self._vfr       = None
        self._nav_ctrl  = None
        self._wind      = None

        # File handles
        self._flight_f = self._angle_f = self._event_f = None
        self._flight_w = self._angle_w = self._event_w = None

        # ── Open log files ────────────────────────────
        if log_flight:
            self._open_flight_log()
        if log_angles:
            self._open_angle_log()
        if log_events:
            self._open_event_log()

        # ── MAVROS subscriptions (direct, no custom msg) ──
        self.create_subscription(
            Odometry, '/mavros/local_position/odom',
            self._odom_cb, SENSOR_QOS)
        self.create_subscription(
            TwistStamped, '/mavros/local_position/velocity_body',
            self._vel_body_cb, SENSOR_QOS)
        self.create_subscription(
            Imu, '/mavros/imu/data',
            self._imu_cb, SENSOR_QOS)
        self.create_subscription(
            NavSatFix, '/mavros/global_position/global',
            self._gps_cb, SENSOR_QOS)
        self.create_subscription(
            BatteryState, '/mavros/battery',
            self._battery_cb, SENSOR_QOS)
        self.create_subscription(
            RCOut, '/mavros/rc/out',
            self._rcout_cb, SENSOR_QOS)
        self.create_subscription(
            State, '/mavros/state',
            self._mavstate_cb, RELIABLE_QOS)
        self.create_subscription(
            VfrHud, '/mavros/vfr_hud',
            self._vfr_cb, SENSOR_QOS)
        self.create_subscription(
            NavControllerOutput,
            '/mavros/nav_controller_output/output',
            self._nav_ctrl_cb, SENSOR_QOS)

        try:
            self.create_subscription(
                TwistWithCovarianceStamped,
                '/mavros/wind_estimation',
                self._wind_cb, SENSOR_QOS)
        except Exception:
            pass

        # ── Payload angles ────────────────────────────
        self.create_subscription(
            PayloadAngles, '/payload/angles',
            self._angles_cb, SENSOR_QOS)

        # ── Mission subscriptions ─────────────────────
        self.create_subscription(
            MissionState, '/mission/state',
            self._mission_state_cb, RELIABLE_QOS)
        self.create_subscription(
            MissionEvent, '/mission/event',
            self._mission_event_cb, RELIABLE_QOS)

        # ── 50Hz logging timer ────────────────────────
        self.create_timer(0.02, self._log_cb)

        # ── Diagnostics timer ─────────────────────────
        self.create_timer(5.0, self._diagnostics)

        if autostart:
            self.start_logging()

        self.get_logger().info(
            f'Logger node started → {self.run_dir}')

    # ── MAVROS callbacks ──────────────────────────────
    def _odom_cb(self, msg):       self._odom = msg
    def _vel_body_cb(self, msg):   self._vel_body = msg
    def _imu_cb(self, msg):        self._imu = msg
    def _gps_cb(self, msg):        self._gps = msg
    def _battery_cb(self, msg):    self._battery = msg
    def _rcout_cb(self, msg):      self._rc_out = msg
    def _mavstate_cb(self, msg):   self._mav_state = msg
    def _vfr_cb(self, msg):        self._vfr = msg
    def _nav_ctrl_cb(self, msg):   self._nav_ctrl = msg
    def _wind_cb(self, msg):       self._wind = msg

    def _angles_cb(self, msg):
        if not self.logging_active or \
           not self.mission_active or \
           self._angle_w is None:
            return
        t = self._mission_elapsed()
        self._angle_w.writerow([
            round(t, 5),
            round(msg.pitch_deg, 4),
            round(msg.roll_deg,  4),
            msg.pitch_count,
            msg.roll_count,
            round(msg.deg_per_count, 6),
        ])
        self.angle_rows += 1

    # ── Main 50Hz log callback ─────────────────────────
    def _log_cb(self):
        if not self.logging_active or \
           not self.mission_active or \
           self._flight_w is None:
            return
        t = self._mission_elapsed()

        # Position + velocity
        x=y=z=vx=vy=vz=vx_b=vy_b=vz_b=0.0
        roll=pitch=yaw=0.0
        if self._odom:
            p = self._odom.pose.pose.position
            v = self._odom.twist.twist.linear
            x,y,z = p.x,p.y,p.z
            vx,vy,vz = v.x,v.y,v.z
            roll,pitch,yaw = quat_to_rpy_deg(
                self._odom.pose.pose.orientation)
        if self._vel_body:
            vb = self._vel_body.twist.linear
            vx_b,vy_b,vz_b = vb.x,vb.y,vb.z

        # IMU
        p_=q_=r_=ax=ay=az=0.0
        if self._imu:
            av = self._imu.angular_velocity
            la = self._imu.linear_acceleration
            p_ = math.degrees(av.x)
            q_ = math.degrees(av.y)
            r_ = math.degrees(av.z)
            ax,ay,az = la.x,la.y,la.z

        # GPS
        lat=lon=alt_gps=0.0
        gps_fix=gps_sats=0
        gps_std=0.3
        if self._gps:
            lat = self._gps.latitude
            lon = self._gps.longitude
            alt_gps = self._gps.altitude
            gps_fix = self._gps.status.status

        # VFR
        heading=groundspeed=airspeed=throttle=alt_baro=climb=0.0
        if self._vfr:
            heading     = float(self._vfr.heading)
            groundspeed = self._vfr.groundspeed
            airspeed    = self._vfr.airspeed
            throttle    = self._vfr.throttle
            alt_baro    = self._vfr.altitude
            climb       = self._vfr.climb

        # Nav controller
        nav_roll=nav_pitch=0.0
        if self._nav_ctrl:
            nav_roll  = self._nav_ctrl.nav_roll
            nav_pitch = self._nav_ctrl.nav_pitch

        # Wind
        wx=wy=wz=0.0
        if self._wind:
            wx = self._wind.twist.twist.linear.x
            wy = self._wind.twist.twist.linear.y
            wz = self._wind.twist.twist.linear.z

        # Motors
        m1=m2=m3=m4=0
        if self._rc_out and len(self._rc_out.channels) >= 4:
            ch = self._rc_out.channels
            m1,m2,m3,m4 = ch[0],ch[1],ch[2],ch[3]

        # Battery
        batt_v=batt_a=batt_pct=0.0
        if self._battery:
            batt_v   = self._battery.voltage
            batt_a   = self._battery.current
            batt_pct = self._battery.percentage

        # Mode
        mode=''; armed=guided=False
        if self._mav_state:
            mode   = self._mav_state.mode
            armed  = self._mav_state.armed
            guided = self._mav_state.guided

        self._flight_w.writerow([
            round(t,4),
            round(x,4),round(y,4),round(z,4),
            round(vx,4),round(vy,4),round(vz,4),
            round(vx_b,4),round(vy_b,4),round(vz_b,4),
            round(roll,3),round(pitch,3),round(yaw,3),
            round(p_,4),round(q_,4),round(r_,4),
            round(ax,4),round(ay,4),round(az,4),
            round(lat,8),round(lon,8),round(alt_gps,3),
            gps_fix,gps_sats,round(gps_std,3),
            round(alt_baro,3),round(climb,4),
            round(heading,1),round(groundspeed,4),
            round(airspeed,4),round(throttle,4),
            round(nav_roll,4),round(nav_pitch,4),
            round(wx,4),round(wy,4),round(wz,4),
            m1,m2,m3,m4,
            round(batt_v,3),round(batt_a,3),round(batt_pct,3),
            int(armed),int(guided),mode,
        ])
        self.flight_rows += 1

    # ── File setup ────────────────────────────────────
    def _open_flight_log(self):
        path = os.path.join(self.run_dir, 'flight.csv')
        self._flight_f = open(path, 'w', newline='')
        self._flight_w = csv.writer(self._flight_f)
        self._flight_w.writerow([
            't','x','y','z','vx','vy','vz',
            'vx_b','vy_b','vz_b',
            'roll','pitch','yaw','p','q','r',
            'ax','ay','az',
            'lat','lon','alt_gps','gps_fix','gps_sats','gps_pos_std',
            'alt_baro','climb_rate','heading','groundspeed','airspeed',
            'throttle','nav_roll_cmd','nav_pitch_cmd',
            'wind_x','wind_y','wind_z',
            'motor1','motor2','motor3','motor4',
            'batt_v','batt_a','batt_pct','armed','guided','mode',
        ])
        self.get_logger().info(f'Flight log → {path}')

    def _open_angle_log(self):
        path = os.path.join(self.run_dir, 'angles.csv')
        self._angle_f = open(path, 'w', newline='')
        self._angle_w = csv.writer(self._angle_f)
        self._angle_w.writerow([
            't','pitch_deg','roll_deg',
            'pitch_count','roll_count','deg_per_count'])
        self.get_logger().info(f'Angle log → {path}')

    def _open_event_log(self):
        path = os.path.join(self.run_dir, 'events.csv')
        self._event_f = open(path, 'w', newline='')
        self._event_w = csv.writer(self._event_f)
        self._event_w.writerow([
            't_wall','t_mission','event_type','description','value'])
        self.get_logger().info(f'Event log → {path}')

    # ── Logging control ───────────────────────────────
    def start_logging(self):
        self.mission_start_t = self.get_clock().now()
        self.logging_active  = True
        self.mission_active  = False
        self.flight_rows     = 0
        self.angle_rows      = 0
        self.event_rows      = 0
        self.get_logger().info('Logging STARTED')
        self._log_event('LOGGER_START', 'Logging started', 0.0)

    def stop_logging(self):
        self.logging_active = False
        self.mission_active = False
        self._log_event('LOGGER_STOP', 'Logging stopped', 0.0)
        self.get_logger().info(
            f'Logging STOPPED — '
            f'flight={self.flight_rows} rows  '
            f'angles={self.angle_rows} rows  '
            f'events={self.event_rows} rows')
        self._save_metadata()
        self._flush_and_close()

    def _mission_elapsed(self):
        if self.mission_start_t is None:
            return 0.0
        dt = self.get_clock().now() - self.mission_start_t
        return dt.nanoseconds / 1e9

    # ── Mission callbacks ─────────────────────────────
    def _mission_state_cb(self, msg):
        if not self.logging_active:
            return
        if self._last_mission_state != msg.state:
            self._last_mission_state = msg.state
            self._log_event(
                'MISSION_STATE',
                f'{msg.state} cmd={msg.cmd_index}/{msg.cmd_total}',
                msg.mission_time)
            if msg.state in ('DONE', 'ABORTED'):
                self.get_logger().info(
                    f'Mission {msg.state} — stopping logger')
                self.stop_logging()

    def _mission_event_cb(self, msg):
        if not self.logging_active:
            return
        self._log_event(
            msg.event_type,
            msg.description,
            msg.mission_time)
        if msg.event_type == 'MISSION_START':
            self.mission_active  = True
            self.mission_start_t = self.get_clock().now()
            self.get_logger().info(
                'Mission active — flight logging started')

    def _log_event(self, event_type, description, mission_time):
        if self._event_w is None:
            return
        self._event_w.writerow([
            datetime.now().isoformat(),
            round(mission_time, 4),
            event_type,
            description,
            '',
        ])
        self.event_rows += 1

    # ── Metadata ──────────────────────────────────────
    def _save_metadata(self):
        meta = {
            'timestamp':     self.timestamp,
            'label':         self.label,
            'operator':      self.operator,
            'shaper_type':   self.shaper,
            'rope_length_m': self.rope,
            'notes':         self.notes,
            'mission_file':  self.mission,
            'config_file':   self.config,
            'flight_rows':   self.flight_rows,
            'angle_rows':    self.angle_rows,
            'event_rows':    self.event_rows,
            'run_dir':       self.run_dir,
        }
        path = os.path.join(self.run_dir, 'metadata.json')
        with open(path, 'w') as f:
            json.dump(meta, f, indent=2)
        self.get_logger().info(f'Metadata saved → {path}')
        for src in [self.mission, self.config]:
            if src and os.path.exists(src):
                shutil.copy2(src, self.run_dir)

    def _flush_and_close(self):
        for f in [self._flight_f, self._angle_f, self._event_f]:
            if f:
                f.flush()
                f.close()
        self.get_logger().info('Log files closed')

    def _diagnostics(self):
        if self.logging_active:
            self.get_logger().info(
                f'Logging — '
                f'flight={self.flight_rows}  '
                f'angles={self.angle_rows}  '
                f'events={self.event_rows}  '
                f'active={self.mission_active}')

    def destroy_node(self):
        if self.logging_active:
            self.stop_logging()
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    try:
        node = LoggerNode()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        try:
            node.destroy_node()
        except Exception:
            pass
        rclpy.shutdown()


if __name__ == '__main__':
    main()
